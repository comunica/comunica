{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@comunica/config-query-sparql/^5.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@comunica/actor-query-source-identify-hypermedia-sparql/^5.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@comunica/actor-optimize-query-operation-prune-empty-source-operations/^5.0.0/components/context.jsonld"
  ],
  "import": [
    "../../engines/query-sparql/config/config-default.json"
  ],
  "@graph": [
    {
      "@id": "urn:comunica:benchmark-largerdfbench-file:ask:sparql",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:comunica:default:query-source-identify-hypermedia/actors#sparql"
      },
      "overrideSteps": [
        {
          "@type": "OverrideParameters",
          "overrideValue": {
            "@type": "ActorQuerySourceIdentifyHypermediaSparql",
            "cardinalityCountQueries": false
          }
        }
      ]
    },
    {
      "@id": "urn:comunica:benchmark-largerdfbench-file:ask:prune",
      "@type": "Override",
      "overrideInstance": {
        "@id": "urn:comunica:default:optimize-query-operation/actors#prune-empty-source-operations"
      },
      "overrideSteps": [
        {
          "@type": "OverrideParameters",
          "overrideValue": {
            "@type": "ActorOptimizeQueryOperationPruneEmptySourceOperations",
            "useAskIfSupported": true
          }
        }
      ]
    }
  ]
}
